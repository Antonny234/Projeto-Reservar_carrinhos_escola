# Django Settings
DJANGO_SECRET_KEY=sua_chave_secreta_super_segura_aqui
DJANGO_DEBUG=False
IS_PRODUCTION=True

# Banco de Dados (Railway configurará automaticamente)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CSRF e hosts permitidos
ALLOWED_HOSTS=seu-app.up.railway.app,localhost,127.0.0.1

# Segurança SSL
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
